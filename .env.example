# Copy to .env.local for `npm run dev`. Values below match docker-compose.yml.

# Runtime role (enaibler_app): subject to row-level security. Never a superuser.
DATABASE_URL=postgres://enaibler_app:app@localhost:5432/enaibler
# Schema owner (enaibler_owner): migrations and tenant manifests only.
DATABASE_MIGRATION_URL=postgres://enaibler_owner:owner@localhost:5432/enaibler

# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# Seals stored secrets (credential signing keys, webhook secrets). Required in production;
# development falls back to BETTER_AUTH_SECRET. Never change it without re-sealing (docs/deployment.md §9).
# DATA_ENCRYPTION_SECRET=

# Development: academies on http://<tenant-slug>.localhost:3000. Plain localhost is the
# platform site (create an academy) unless DEV_DEFAULT_TENANT puts an academy there.
# DEV_DEFAULT_TENANT=demo
DEV_PORT=3000
# APP_PROTOCOL=https   # defaults to https in production, http otherwise

# Transactional mail via the EU SMTP relay. Unset in development: mails are printed.
EMAIL_FROM_ADDRESS=academy@mail.example.com
# SMTP_URL=smtp://localhost:1025   # mailpit from docker-compose.yml

# S3-compatible storage: SeaweedFS from docker-compose.yml (uploads, recordings, exports)
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=enaibler
S3_ACCESS_KEY_ID=enaibler
S3_SECRET_ACCESS_KEY=enaibler-dev-secret
# S3_REGION=eu-central-1

# LiteLLM gateway (OpenAI-compatible), used by the AI review and the brand import
# LLM_BASE_URL=http://localhost:4000/v1
# LLM_API_KEY=
# LLM_REVIEW_MODEL=review-default
# Brand import and authoring models; both default to LLM_REVIEW_MODEL.
# LLM_BRAND_MODEL=
# LLM_AUTHORING_MODEL=
# Embeddings for source retrieval (1024 dimensions); without it, keyword retrieval.
# LLM_EMBEDDING_MODEL=

# Self-hosted Whisper (OpenAI-compatible, e.g. speaches) for recordings; the worker also needs ffmpeg.
# WHISPER_BASE_URL=http://localhost:8000/v1
# WHISPER_MODEL=Systran/faster-whisper-small
# WHISPER_API_KEY=
# FFMPEG_PATH=/usr/bin/ffmpeg

# Monthly AI allowance of an academy in US dollars of provider cost, unless the operator gave it
# its own (docs/deployment.md §11). Unset: no limit. A call the gateway could not price counts
# at AI_UNPRICED_CALL_USD (default 0.05).
# AI_MONTHLY_ALLOWANCE_USD=20
# AI_UNPRICED_CALL_USD=0.05

# Video storage of an academy in gigabytes (uploaded originals and their HLS renditions),
# unless the operator gave it its own (docs/deployment.md §11). Unset: no limit.
# MEDIA_STORAGE_QUOTA_GB=50

# Self-serve platform. Development defaults to localhost for both. In production an unset
# PLATFORM_HOST turns signup off, and signup also needs terms and a DPA in force: the
# built-in pages (content/legal) marked final, or the operator's own links below.
# PLATFORM_HOST=enaibler.app
# ACADEMY_DOMAIN=academies.enaibler.app
# Legal pages kept elsewhere; each replaces its built-in page.
# PLATFORM_TERMS_URL=
# PLATFORM_DPA_URL=
# PLATFORM_PRIVACY_URL=
# PLATFORM_IMPRINT_URL=
# An academy the website links to as a demo (no link when unset).
# PLATFORM_DEMO_URL=
# Unset: a built-in page's last-updated date is the version recorded at signup.
# PLATFORM_AGREEMENT_VERSION=2026-09
# Content reports from /report (development: abuse@enaibler.local) and a note per new academy.
# PLATFORM_ABUSE_EMAIL=abuse@enaibler.app
# PLATFORM_NOTIFY_EMAIL=team@enaibler.app

# Own domains for academies (docs/deployment.md §6): what they point at (default
# <slug>.<ACADEMY_DOMAIN>) and the reverse proxy's config endpoint.
# CUSTOM_DOMAIN_TARGET=domains.enaibler.app
# PROXY_CONFIG_TOKEN=
# PROXY_SERVICE_URL=http://web:3000
# PROXY_HTTP_ENTRYPOINT=http
# PROXY_HTTPS_ENTRYPOINT=https
# PROXY_CERT_RESOLVER=letsencrypt
# Proxies whose X-Forwarded-For counts for rate limits (default: private ranges).
# TRUSTED_PROXY_CIDRS=

# Cookieless page views with self-hosted Umami or Plausible CE (off when unset).
# ANALYTICS_PROVIDER=umami
# ANALYTICS_SCRIPT_URL=https://stats.example.com/script.js
# ANALYTICS_WEBSITE_ID=
# Errors to GlitchTip (Sentry-compatible DSN), with release and environment.
# ERROR_REPORTING_DSN=https://<key>@errors.example.com/1
# APP_RELEASE=
# APP_ENV=staging
# json (default in production) or text
# LOG_FORMAT=
# Dates in the Studio (default Europe/Berlin)
# APP_TIME_ZONE=Europe/Berlin

# Local tests only: host:port list the brand import, source reading and webhooks may reach
# despite the private-address check.
# SAFE_FETCH_ALLOWED_HOSTS=127.0.0.1:4020

# Tests against a real Postgres prepared with deploy/postgres/init.sh
# TEST_DATABASE_URL=postgres://enaibler_app:app@localhost:5432/enaibler_test
# TEST_DATABASE_MIGRATION_URL=postgres://enaibler_owner:owner@localhost:5432/enaibler_test
