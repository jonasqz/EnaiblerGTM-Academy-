# Copy to .env.local for `npm run dev`. Values below match docker-compose.yml.

# Runtime role (enaibler_app): subject to row-level security. Never a superuser.
DATABASE_URL=postgres://enaibler_app:app@localhost:5432/enaibler
# Schema owner (enaibler_owner): migrations and tenant manifests only.
DATABASE_MIGRATION_URL=postgres://enaibler_owner:owner@localhost:5432/enaibler

# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# Development: academies on http://<tenant-slug>.localhost:3000. Plain localhost is the
# platform site (create an academy) unless DEV_DEFAULT_TENANT puts an academy there.
# DEV_DEFAULT_TENANT=demo
DEV_PORT=3000
# APP_PROTOCOL=https   # defaults to https in production, http otherwise

# Transactional mail via the EU SMTP relay. Unset in development: mails are printed.
EMAIL_FROM_ADDRESS=academy@mail.example.com
# SMTP_URL=smtp://localhost:1025   # mailpit from docker-compose.yml

# S3-compatible storage: SeaweedFS from docker-compose.yml (uploads, recordings, exports)
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=enaibler
S3_ACCESS_KEY_ID=enaibler
S3_SECRET_ACCESS_KEY=enaibler-dev-secret
# S3_REGION=eu-central-1

# LiteLLM gateway (OpenAI-compatible), used by the AI review and the brand import
# LLM_BASE_URL=http://localhost:4000/v1
# LLM_API_KEY=
# LLM_REVIEW_MODEL=review-default
# Brand import and authoring models; both default to LLM_REVIEW_MODEL.
# LLM_BRAND_MODEL=
# LLM_AUTHORING_MODEL=
# Embeddings for source retrieval (1024 dimensions); without it, keyword retrieval.
# LLM_EMBEDDING_MODEL=

# Self-hosted Whisper (OpenAI-compatible, e.g. speaches) for recordings; the worker also needs ffmpeg.
# WHISPER_BASE_URL=http://localhost:8000/v1
# WHISPER_MODEL=Systran/faster-whisper-small
# FFMPEG_PATH=/usr/bin/ffmpeg

# Self-serve platform. Development defaults to localhost for both. In production an unset
# PLATFORM_HOST turns signup off, and signup also needs the terms and DPA links.
# PLATFORM_HOST=enaibler.app
# ACADEMY_DOMAIN=academies.enaibler.app
# PLATFORM_TERMS_URL=
# PLATFORM_DPA_URL=
# PLATFORM_PRIVACY_URL=
# PLATFORM_IMPRINT_URL=
# PLATFORM_AGREEMENT_VERSION=2026-09
# Local tests only: host:port list the brand import may read despite the private-address check.
# BRAND_IMPORT_ALLOWED_HOSTS=127.0.0.1:4020

# Tests against a real Postgres prepared with deploy/postgres/init.sh
# TEST_DATABASE_URL=postgres://enaibler_app:app@localhost:5432/enaibler_test
# TEST_DATABASE_MIGRATION_URL=postgres://enaibler_owner:owner@localhost:5432/enaibler_test
