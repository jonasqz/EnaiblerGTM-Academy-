{
  "name": "enaibler",
  "version": "0.1.0",
  "private": true,
  "description": "Proof-of-work academies: learners build real work, AI reviews it, the credential is backed by the work.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env.local src/worker/index.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --project db",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "tenant:apply": "tsx --env-file-if-exists=.env.local scripts/tenant-apply.ts",
    "tenant:validate": "tsx scripts/tenant-apply.ts --dry-run",
    "role:grant": "tsx --env-file-if-exists=.env.local scripts/grant-role.ts",
    "usage:report": "tsx --env-file-if-exists=.env.local scripts/usage-report.ts",
    "academy": "tsx --env-file-if-exists=.env.local scripts/academy.ts",
    "smoke": "tsx scripts/smoke.ts",
    "review:spike": "tsx --env-file-if-exists=.env.local scripts/review-spike.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/lib-storage": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-email/render": "^2.1.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "hls.js": "1.7.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
